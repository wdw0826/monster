# docker-compose.yml 用的機密設定範本。
# 用法：複製這份成 .env（.env 本身不會進 git），把下面的值換成自己的。
#
#   cp .env.example .env

# Postgres 帳密（app 跟 postgres 服務都是讀這兩個）
DB_USERNAME=postgres
DB_PASSWORD=change-me-to-a-real-password

# JWT 簽章密鑰，HS256 最少要 32 bytes（256 bits），隨便打一串夠長的亂數字串就好，
# 不要用下面這個範例值直接上線。
JWT_SECRET=please-replace-this-with-a-random-string-at-least-32-bytes-long
