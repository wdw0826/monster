{
  "info": {
    "_postman_id": "6f6a1e2a-6f2e-4e2d-9e1a-0729pmonster1",
    "name": "MonsterHunter API",
    "description": "魔物獵人 REST API 全套測試集合，資料夾照現有 postman截圖/ 的分類方式（Auth / Player / Quest / Battle / Store / Admin / Security）。\n\n**跑之前**：\n1. 對一個乾淨的資料庫跑（`docker compose down -v && docker compose up -d --build`），因為部分請求假設任務板是初始狀態（quest 3/4/5/6/7/8 都還沒被接）。\n2. 從上到下、整個 collection 一次跑完（Collection Runner 或逐一手動點）——後面的請求依賴前面請求存下來的 accessToken/refreshToken/id 等變數。\n3. Admin 資料夾需要先手動把 ROLE_ADMIN 灌給 0729player 這個帳號（README「怎麼弄一個 ADMIN 帳號」那段的 SQL），API 本身故意不開放自己把自己升級成 admin。\n\n數值都是照遊戲規則算好的固定值（這個系統沒有隨機數），照順序跑就會對得上斷言；如果中途改了順序或重跑局部，數值會對不上，屬於預期行為。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "0729player" },
    { "key": "email", "value": "0729player@test.com" },
    { "key": "password", "value": "password123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "staleRefreshToken", "value": "" },
    { "key": "playerId", "value": "" },
    { "key": "otherUsername", "value": "0729player-other" },
    { "key": "otherEmail", "value": "0729player-other@test.com" },
    { "key": "otherAccessToken", "value": "" },
    { "key": "otherRefreshToken", "value": "" },
    { "key": "otherPlayerId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "註冊、登入、refresh token 輪換、登出。這個資料夾自己跑到底，最後會是登出狀態，後面的資料夾各自會重新登入拿新 token，不依賴這裡結束時的狀態。",
      "item": [
        {
          "name": "Register_201Created",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 建立成功，或 400 表示這個帳號先前已經註冊過（可重複執行）', function () {",
            "    pm.expect([201, 400]).to.include(pm.response.code);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login_200OK",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200，回傳 accessToken/refreshToken', function () {",
            "    pm.response.to.have.status(200);",
            "    var body = pm.response.json();",
            "    pm.expect(body.accessToken).to.be.a('string');",
            "    pm.expect(body.refreshToken).to.be.a('string');",
            "    pm.collectionVariables.set('accessToken', body.accessToken);",
            "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login_SameAccount_Twice_200OK",
          "description": "專門抓 RefreshTokenService 忘記加 @Transactional 的地雷：第一次登入過不代表沒事，同帳號馬上再登入一次才是真的測試。",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('staleRefreshToken', pm.collectionVariables.get('refreshToken'));"
          ]}}, { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('同帳號連續登入第二次一樣 200', function () {",
            "    pm.response.to.have.status(200);",
            "    var body = pm.response.json();",
            "    pm.collectionVariables.set('accessToken', body.accessToken);",
            "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "RefreshToken_401Invalid_OldToken",
          "description": "第一次登入拿到的 refreshToken，在第二次登入時已經被 deleteByUser 砍掉、換成新的了，拿舊的來 refresh 應該失效。",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('舊的 refreshToken 已失效，401', function () {",
            "    pm.response.to.have.status(401);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{staleRefreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "RefreshToken_200OK",
          "description": "用目前有效的 refreshToken 換一組新的，驗證輪換機制（換到的是新的一組，不是原地回傳同一個）。",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var oldRefresh = pm.collectionVariables.get('refreshToken');",
            "pm.test('200，換到新的 accessToken + refreshToken', function () {",
            "    pm.response.to.have.status(200);",
            "    var body = pm.response.json();",
            "    pm.expect(body.refreshToken).to.not.eql(oldRefresh);",
            "    pm.collectionVariables.set('accessToken', body.accessToken);",
            "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout_200OK",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 登出成功', function () {",
            "    pm.response.to.have.status(200);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "RefreshToken_401_AfterLogout",
          "description": "登出會撤銷這個帳號全部的 refreshToken，剛剛登出用的那個現在應該也失效了。",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('登出後這個 refreshToken 也失效，401', function () {",
            "    pm.response.to.have.status(401);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        }
      ]
    },
